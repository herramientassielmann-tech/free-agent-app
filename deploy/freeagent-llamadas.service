[Unit]
Description=Resumen de las llamadas grabadas en Fireflies
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=root
WorkingDirectory=/var/www/freeagent
# Sin prisa: baja varias transcripciones y las pasa por el modelo.
TimeoutStartSec=900
ExecStart=/var/www/freeagent/.venv/bin/python3 scripts/resumir_llamadas.py
